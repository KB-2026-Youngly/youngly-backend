<?xml version="1.0" encoding="UTF-8" ?>
<!--
  매퍼 XML 템플릿

  [INFO] 사용 방법
    1. 이 파일을 같은 디렉터리에 <인터페이스명>.xml 로 복사한다.
       예) UserMapper 인터페이스 -> UserMapper.xml
    2. namespace 를 매퍼 인터페이스의 전체 경로로 바꾼다.
    3. 파일명과 인터페이스명, namespace 가 모두 일치해야 인식된다.

  [WARN] 경로 규칙
    src/main/resources/com/kb/youngly/mapper/ 아래에 두어야 한다.
    IntelliJ 에서 디렉터리를 새로 만들 때는 "com.kb.youngly.mapper" 가 아니라
    "com/kb/youngly/mapper" 형태로 입력할 것.
-->
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kb.youngly.mapper.SampleMapper">

</mapper>
