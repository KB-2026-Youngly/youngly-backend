<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <settings>
        <!-- [INFO] DB 의 snake_case 컬럼을 자바의 camelCase 필드에 자동 매핑한다.
                    예) created_at -> createdAt -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>

        <!-- [INFO] 조회 결과가 null 인 컬럼도 Map 에 포함시킨다. -->
        <setting name="callSettersOnNulls" value="true"/>

        <!-- [INFO] JDBC 가 생성한 키(auto_increment)를 사용한다. -->
        <setting name="useGeneratedKeys" value="true"/>
    </settings>

    <typeAliases>
        <!-- [INFO] 매퍼 XML 에서 패키지명 없이 클래스명만으로 참조할 수 있게 한다. -->
        <package name="com.kb.youngly.domain"/>
        <package name="com.kb.youngly.dto"/>
    </typeAliases>

</configuration>
