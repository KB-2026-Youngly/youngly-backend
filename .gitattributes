# ============================================================================
# 줄바꿈 정규화
# [INFO] Windows/macOS 혼용 팀에서 전체 파일이 변경된 것처럼 보이는 문제를 막는다.
# ============================================================================

* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 유닉스 실행 스크립트는 LF 고정
gradlew text eol=lf

# 바이너리 파일은 변환하지 않는다
*.jar   binary
*.war   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
*.woff  binary
*.woff2 binary
